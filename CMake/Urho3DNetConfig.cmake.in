# Package configuration of the C# bindings of rbfx (installed form).
# Usage:
#   find_package(Urho3D REQUIRED)
#   find_package(Urho3DNet REQUIRED)
#   csharp_bind_target(TARGET MyPlugin SWIG ... CSPROJ ... NAMESPACE Urho3DNet)

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# The bindings need the engine.
find_dependency(Urho3D)

include("${CMAKE_CURRENT_LIST_DIR}/Urho3DNet.cmake")

set(Urho3DNet_FOUND TRUE)

# Provide path to package root
set(Urho3DNet_PACKAGE_ROOT "${PACKAGE_PREFIX_DIR}")
set(Urho3DNet_IS_SDK ON)

list(APPEND CMAKE_MODULE_PATH "${PACKAGE_PREFIX_DIR}/share/Urho3DNet/CMake/Modules")
include(Urho3DNetCommon)
